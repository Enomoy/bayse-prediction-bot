from __future__ import annotations

import logging
from typing import Any

from bayse_markets import BayseClient

logger = logging.getLogger(__name__)


async def list_open_events(client: BayseClient, *, page: int = 1, size: int = 20) -> list[Any]:
    resp = await client.list_events(page=page, size=size)
    events = getattr(resp.data, "events", None) or getattr(resp.data, "data", []) or []
    logger.info("Fetched %d events", len(events))
    return events


async def print_market_summary(client: BayseClient, limit: int = 10) -> None:
    events = await list_open_events(client, size=limit)

    if not events:
        print("No open events found.")
        return

    print("\n" + "="*70)
    print("Bayse Markets – Top open events".center(70))
    print("="*70)

    for i, event in enumerate(events, 1):
        title = getattr(event, "title", None) or getattr(event, "name", "Unknown")
        status = getattr(event, "status", "?")
        closing = getattr(event, "closing_date", None) or getattr(event, "end_date", "?")
        print(f"{i:2}. [{status}] {title}")
        print(f"    Closes: {closing}")
        print()